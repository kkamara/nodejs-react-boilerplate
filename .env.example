APP_NAME='NodeJS React Boilerplate'
# Generate with
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_KEY='your-app-key-here-generate-with-openssl-rand-hex-32'
NODE_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000

PORT=8000

# DB creds are set in ./config.json
# but also here for Docker usage
DB_HOST=mysql
DB_PASS=secret
DB_NAME=boilerplate
DB_USER=user
DB_PORT=3306

MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="'Admin' <admin@example.com>"
MAIL_TO="bar@example.com, baz@example.com"
